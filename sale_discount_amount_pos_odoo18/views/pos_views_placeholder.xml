<odoo>
    <record id="view_company_form_inherit_pos_discount_placeholder" model="ir.ui.view">
        <field name="name">res.company.form.pos.discount.placeholder</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="POS Settings" attrs="{'invisible': True}">
                    <span class="o_form_label">POS Discount Placeholder</span>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
