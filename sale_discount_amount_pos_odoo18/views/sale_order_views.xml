<odoo>
  <record id="view_order_form_discount_amount" model="ir.ui.view">
    <field name="name">sale.order.line.discount.amount.view</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='order_line']/form//field[@name='discount']" position="after">
        <field name="discount_amount"/>
      </xpath>
      <xpath expr="//field[@name='order_line']/list//field[@name='discount']" position="after">
        <field name="discount_amount"/>
      </xpath>
    </field>
  </record>
</odoo>
